{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2019", "DOM"],
    "target": "es6",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "./",
    "jsx": "react",
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
