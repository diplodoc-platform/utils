{
  "name": "@diplodoc/utils",
  "version": "2.3.6",
  "description": "Diplodoc cross-packages utils",
  "homepage": "https://github.com/diplodoc-platform/utils",
  "repository": {
    "type": "git",
    "url": "git@github.com:diplodoc-platform/utils.git"
  },
  "engines": {
    "npm": ">=11.5.1"
  },
  "bugs": {
    "url": "https://github.com/diplodoc-platform/utils/issues"
  },
  "keywords": [
    "diplodoc",
    "markdown",
    "utils"
  ],
  "types": "./build/esm/common/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/common/index.d.ts",
      "node": "./build/cjs/common/index.js",
      "default": "./build/esm/common/index.js"
    },
    "./react": {
      "types": "./build/esm/react/index.d.ts",
      "node": "./build/cjs/react/index.js",
      "default": "./build/esm/react/index.js"
    },
    "./ya-make": {
      "types": "./build/esm/ya-make/index.d.ts",
      "node": "./build/cjs/ya-make/index.js",
      "default": "./build/esm/ya-make/index.js"
    }
  },
  "files": [
    "build/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:clean && run-p build:code build:esm build:cjs",
    "build:code": "node esbuild/bundle.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "lint",
    "lint:fix": "lint fix",
    "pre-commit": "lint-staged",
    "prepare": "husky || true",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "build:clean": "rm -rf build",
    "build:declarations": "run-p build:esm build:cjs",
    "lock": "npm install --no-workspaces --package-lock-only --ignore-scripts"
  },
  "license": "MIT",
  "devDependencies": {
    "@diplodoc/infra": "2.2.3",
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@types/markdown-it": "^13.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild-node-externals": "^1.20.1",
    "markdown-it": "^13.0.2",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
